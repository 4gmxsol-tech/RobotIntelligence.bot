{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "robotintelligence-bot",
  "main": "./worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "secrets": {
    "required": []
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true
}
