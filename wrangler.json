{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"robot-intelligence-bot",
  "main":"./worker.js",
  "compatibility_date":"2026-09-24",
  "assets":{
    "directory":".",
    "binding":"ASSETS",
    "run_worker_first":["/api/*"]
  },
  "secrets":{
    "required":[]
  },
  "routes":[
    {"pattern":"robotintelligence.bot","custom_domain":true},
    {"pattern":"www.robotintelligence.bot","custom_domain":true}
  ]
}
